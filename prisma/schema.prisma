generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AssistanceRequest {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String
  email     String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransparencyDonation {
  id          String   @id @default(cuid())
  description String
  amount      Float?
  category    String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TransparencyExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PublicRequest {
  id              String    @id @default(cuid())
  title           String
  description     String
  requestedAmount Float
  fundedAmount    Float     @default(0)
  fullyFunded     Boolean   @default(false)
  date            DateTime?
  imageUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  donations       Donation[]
}

model Donation {
  id                    String         @id @default(cuid())
  amount                Float
  currency              String         @default("usd")
  frequency             String         @default("one-time")
  category              String?
  status                String         @default("pending")
  donorEmail            String?
  donorName             String?
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?        @unique
  stripeSubscriptionId  String?
  stripeCustomerId      String?
  publicRequestId       String?
  publicRequest         PublicRequest? @relation(fields: [publicRequestId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([publicRequestId])
  @@index([stripeSubscriptionId])
}
